Typescript RECORD type examples:
================================

/**
 * @file This file contains five complex TypeScript examples demonstrating the use of the `Record` utility type.
 * Each example showcases a different real-world scenario where `Record` simplifies type definition and enhances code safety.
 */

// Example 1: Creating a Multi-Dimensional Look-up Table
// This is used for quick lookups in a complex, nested data structure.
// The `Record<string, Record<string, number>>` type represents an object
// with string keys, where each value is another object with string keys and number values.
type CityTemperature = Record<string, Record<string, number>>;

const yearlyTemperatures: CityTemperature = {
  "New York": { "Jan": 2, "Feb": 3, "Mar": 7, "Apr": 13, "May": 19 },
  "London": { "Jan": 5, "Feb": 5, "Mar": 8, "Apr": 11, "May": 15 },
  "Tokyo": { "Jan": 6, "Feb": 7, "Mar": 10, "Apr": 15, "May": 20 },
};

console.log("Example 1: Yearly Temperatures");
console.log(`Temperature in New York in March: ${yearlyTemperatures["New York"]["Mar"]}°C`);

// ---

// Example 2: Dynamic API Endpoint Configuration
// This is useful for managing a collection of API endpoints with different parameters.
// The `Record<string, ApiEndpoint>` type ensures that all keys are strings
// and their corresponding values adhere to the `ApiEndpoint` interface.
interface ApiEndpoint {
  url: string;
  method: "GET" | "POST" | "PUT" | "DELETE";
  headers?: Record<string, string>;
}

type ApiConfig = Record<string, ApiEndpoint>;

const apiEndpoints: ApiConfig = {
  "getUser": { url: "/api/users/:id", method: "GET" },
  "createUser": {
    url: "/api/users",
    method: "POST",
    headers: { "Content-Type": "application/json", "Authorization": "Bearer token" },
  },
  "updateProduct": { url: "/api/products/:id", method: "PUT" },
};

console.log("\nExample 2: API Endpoint Configuration");
console.log(`User API URL: ${apiEndpoints.getUser.url}`);
console.log(`Create User Headers: ${JSON.stringify(apiEndpoints.createUser.headers)}`);

// ---

// Example 3: Component-to-Prop Mapping
// A common pattern in React or other component-based frameworks is to map
// a component name to its required properties.
type ComponentProps = {
  title: string;
  data: number[];
  onClick?: () => void;
};

// Here, `Record<string, Partial<ComponentProps>>` defines an object where keys are component names (strings)
// and values are partial `ComponentProps` objects. `Partial` makes all properties optional.
type ComponentRegistry = Record<string, Partial<ComponentProps>>;

const componentRegistry: ComponentRegistry = {
  "ChartComponent": { title: "Monthly Sales", data: [10, 20, 30] },
  "ButtonComponent": { onClick: () => console.log("Button clicked!") },
};

console.log("\nExample 3: Component-to-Prop Mapping");
console.log(`Props for ChartComponent: ${JSON.stringify(componentRegistry.ChartComponent)}`);
if (componentRegistry.ButtonComponent.onClick) {
  componentRegistry.ButtonComponent.onClick();
}

// ---

// Example 4: State Management in a Reducer Pattern
// In Redux or a similar state management system, you often have a record of
// entities keyed by their ID. This ensures type safety when updating state.
interface User {
  id: string;
  name: string;
  email: string;
  isActive: boolean;
}

// `Record<string, User>` maps a user ID string to a full User object.
type UsersState = Record<string, User>;

const users: UsersState = {
  "u123": { id: "u123", name: "John Doe", email: "john@example.com", isActive: true },
  "u456": { id: "u456", name: "Jane Smith", email: "jane@example.com", isActive: false },
};

// Simulating a state update
const updatedUser = { ...users["u123"], isActive: false };
const updatedState: UsersState = { ...users, "u123": updatedUser };

console.log("\nExample 4: State Management");
console.log("Original state:", JSON.stringify(users, null, 2));
console.log("Updated state:", JSON.stringify(updatedState, null, 2));

// ---

// Example 5: Internationalization (i18n) Data
// Storing language-specific translations in a nested object. `Record` is perfect for this.
// `Record<string, string>` represents an object with string keys (translation keys) and string values (translated text).
type Translations = Record<string, string>;

// `Record<string, Translations>` represents a language map where keys are language codes
// and values are the translation objects.
type I18nData = Record<string, Translations>;

const i18n: I18nData = {
  "en-US": {
    "greeting": "Hello",
    "farewell": "Goodbye",
    "welcome_message": "Welcome to our application!",
  },
  "es-ES": {
    "greeting": "Hola",
    "farewell": "Adiós",
    "welcome_message": "¡Bienvenido a nuestra aplicación!",
  },
};

console.log("\nExample 5: Internationalization Data");
console.log(`English greeting: ${i18n["en-US"]["greeting"]}`);
console.log(`Spanish welcome message: ${i18n["es-ES"]["welcome_message"]}`);












