* Here we are using also dynamic.xyz's package "@dynamic-labs/ethers-v6". But we can replace it entirely with "ethers" package. And dynamic is not responsible for contract interaction just wallet related small stuffs.

import { getSigner } from "@dynamic-labs/ethers-v6";
import { Contract, parseUnits } from "ethers";
import { useDynamicContext } from "@dynamic-labs/sdk-react-core";

const { primaryWallet } = useDynamicContext();

const tokenAddress = "0x1234566666"; // token smart contract address

const getTokenContract = async () => {
    const signer = await getSigner(primaryWallet as any);

    const tokenContract = new Contract(tokenAddress, SIMPLE_ERC20_ABI, signer);

    return tokenContract;
};

const approveToken = async (amount: bigint): Promise<void> => {

  const tokenContract = await getTokenContract();

  // Call approve function
  const tx = await tokenContract.approve(vaultAddress, amount);

  // Wait for transaction confirmation
  const receipt = await tx.wait();

  console.log("Approval confirmed:", receipt.hash);
};
    
// fn to deposit on smart contract address called vault.
// "asset" is the USDTr token value like 1234045 (qty of token)
const deposit = async (asset: string, receiver?: string) => {

    // Get token contract to read decimals
    const tokenContract = await getTokenContract();
    const decimals = await tokenContract.decimals();

    // converting token qty into decimal value which token should have: 18 or 10 etc
    const assetAmount = parseUnits(asset, decimals);

    // 1. Approve tokens for the vault
    await approveToken(assetAmount);

    // 2. Call deposit on the vault contract
    const signer = await getSigner(primaryWallet as any);

    const vaultContract = new Contract(
      vaultAddress, // vault contract address where deposit is happening.
      SIMPLE_VAULT_ABI,
      signer
    );

    const tx = await vaultContract.deposit(
      assetAmount,
      receiver ?? primaryWallet.address // address of wallet de4positing.
    );

    // Wait for transaction confirmation
    const receipt = await tx.wait();

    if (receipt.status === 1) {
      console.log("✅ Deposit confirmed on-chain:", receipt);
      setSuccess(true);
    } else {
      console.error("❌ Deposit failed on-chain:", receipt);
      setError("Transaction failed");
    }
};


