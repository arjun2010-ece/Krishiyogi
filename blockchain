import { useDynamicContext } from "@dynamic-labs/sdk-react-core";
import { isEthereumWallet } from "@dynamic-labs/ethereum";
import { parseUnits } from "viem";

const { primaryWallet } = useDynamicContext();

const deposit = (assets: string, receiver?: string) => {
	
	// This check is important to activate "getPublicClient" or "getWalletClient"
	// else "primaryWallet" will not have thise methods.
	if (!primaryWallet || !isEthereumWallet(primaryWallet)) {
        return null;
      }

    // Convert amount string to BigInt (assuming 18 decimals)
    const assetAmount = parseUnits(assets, 18); 

    // Initialize clients, also presents in "Viems" documentations also
    // dynamic uses "viem" under the hood.
    const publicClient = primaryWallet.getPublicClient();
    const walletClient = primaryWallet.getWalletClient();

    // Send transaction to smart contract address or calling "deposit" function
