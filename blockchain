contract MappingsStructExample {
    
    struct Transaction {
        uint amount;
        uint timestamp;
    }
    
    struct Balance {
        uint totalBalance;
        uint numDeposits;
        mapping(uint => Transaction) deposits;
        uint numWithdrawals;
        mapping(uint => Transaction) withdrawals;
    }
 
    mapping(address => Balance) public balances;
 
 
    function getBalance(address _addr) public view returns(uint) {
        return balanceReceived[_addr].totalBalance;
    }
 	
 	function getDepositByNum(address _from, uint _numDeposit) public view returns (Transaction memory) {
        return balances[_from].deposits[_numDeposit];
    }

    function depositMoney() public payable {
        Balance storage userBalance =  balances[msg.sender]; // another name for same memory location

        userBalance.totalBalance += msg.value;

        Transaction memory deposit = Transaction(msg.value, block.timestamp);
        userBalance.deposits[userBalance.numDeposits] = deposit;
        userBalance.numDeposits++;
    }
    
    function withdrawMoney(address payable _to, uint _amount) public {
        Balance storage userBalance = balances[msg.sender];
        
        // Reduce the balance by the amount ot withdraw
        userBalance.totalBalance -= _amount;

        // Record the withsrawal in the blockchain
        Transaction memory withdrawal = Transaction(_amount, block.timestamp);
        userBalance.withdrawals[userBalance.numWithdrawals] = withdrawal;
        userBalance.numWithdrawals++;

        // Send the amount out
        _to.transfer(_amount);
    }
}


