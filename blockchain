        address: vaultAddress as `0x${string}`,
        abi: SIMPLE_VAULT_ABI,
        functionName: "deposit",
        args: [assetAmount, receiver ?? primaryWallet.address],
        account: primaryWallet.address as `0x${string}`,
    });

    // Wait for confirmation
    const receipt = publicClient.waitForTransactionReceipt({ hash });

    // Note: The original function had an 'if (receipt.status === "success")' block
    // which is a form of logic/state check. The base call code is simply the call itself.
    return { hash, receipt };
};


Deposit tokens in smart contract using "ethers" package
---------------------------------------------------------

- Below code works amazingly on Dapp with Metamask desktop extension.
